# This is a reference copy of the project's environment variables — kept at
# the repo root for discoverability. The backend only actually reads
# `backend/.env`, so to configure anything you must:
#
#   cp backend/.env.example backend/.env
#
# ...and fill in real values there. Copying this root file to a root `.env`
# does nothing on its own.
#
# The frontend (index.html) has no build step and doesn't read env files at
# all — its one piece of config, API_BASE, is a plain JS constant near the
# top of the <script> block. Edit it directly if you're not running the API
# on localhost:8000.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://logiconnect:logiconnect@localhost:5432/logiconnect
POSTGRES_USER=logiconnect
POSTGRES_PASSWORD=logiconnect
POSTGRES_DB=logiconnect

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Stripe (test mode keys, sk_test_... / pk_test_...) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Mapbox (geocoding + distance) ---
MAPBOX_ACCESS_TOKEN=

# --- Carrier APIs (optional — leave blank to use the built-in simulation adapter) ---
CHRONOPOST_API_KEY=
CHRONOPOST_ACCOUNT_NUMBER=
COLISSIMO_API_KEY=
COLISSIMO_CONTRACT_NUMBER=
DHL_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:5500,http://localhost:8000,http://127.0.0.1:5500

# --- App ---
ENVIRONMENT=development
